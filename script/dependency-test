#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
module_dir="$project_dir/.guix/modules"
if test -d "$project_dir/../dependencies/g-swing"; then
  dependency_root=$(CDPATH= cd -- "$project_dir/../dependencies" && pwd)
else
  dependency_root=$(CDPATH= cd -- "$project_dir/.." && pwd)
fi
worker_state=${GUILE_DMENU_TEST_STATE:-${TMPDIR:?TMPDIR must name writable test storage}/guile-dmenu-tests}
worker_cache="$worker_state/cache"
mkdir -p "$worker_state" "$worker_cache"
case_dir=$(mktemp -d "$worker_state/dependency-test.XXXXXX")
trap 'rm -rf -- "$case_dir"' EXIT HUP INT TERM
swing_source=${GUILE_G_SWING_SOURCE:-$dependency_root/g-swing}
wayland_source=${GUILE_WAYLAND_SOURCE:-$dependency_root/guile-wayland}
export XDG_CACHE_HOME="$worker_cache"

test "$(git -C "$swing_source" rev-parse HEAD)" = \
  f447747004b51949389a4bf2e0f5784d68d13e34
test "$(git -C "$wayland_source" rev-parse HEAD)" = \
  35eff2a28f9843dbdddeee2cc594788b72569bad
test -z "$(git -C "$swing_source" status --porcelain)"
test -z "$(git -C "$wayland_source" status --porcelain)"

export GUILE_G_SWING_SOURCE="$swing_source"
export GUILE_WAYLAND_SOURCE="$wayland_source"

if env -u GUILE_G_SWING_SOURCE \
     guix build -L "$module_dir" --no-grafts --no-offload \
       -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)' \
       >"$case_dir/missing-swing.out" \
       2>"$case_dir/missing-swing.err"; then
  echo "g-swing package silently resolved an ambient dependency source" >&2
  exit 1
fi
grep -q 'GUILE_G_SWING_SOURCE must name the controller-provided dependency source' \
  "$case_dir/missing-swing.err"

if env -u GUILE_WAYLAND_SOURCE \
     guix build -L "$module_dir" --no-grafts --no-offload \
       -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)' \
       >"$case_dir/missing-wayland.out" \
       2>"$case_dir/missing-wayland.err"; then
  echo "guile-wayland package silently resolved an ambient dependency source" >&2
  exit 1
fi
grep -q 'GUILE_WAYLAND_SOURCE must name the controller-provided dependency source' \
  "$case_dir/missing-wayland.err"

if GUILE_G_SWING_SOURCE="$project_dir" \
     guix build -L "$module_dir" --no-grafts --no-offload \
       -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)' \
       >"$case_dir/mislabeled-swing.out" \
       2>"$case_dir/mislabeled-swing.err"; then
  echo "g-swing package accepted a source at the wrong revision" >&2
  exit 1
fi
grep -q 'must resolve to pinned revision' "$case_dir/mislabeled-swing.err"

swing=$(guix build -L "$module_dir" --no-grafts --no-offload \
  -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)')
wayland=$(guix build -L "$module_dir" --no-grafts --no-offload \
  -e '(@ (guile-dmenu-package) guile-wayland-dmenu)')

# A source worktree may acquire tracked, untracked, or ignored files after the
# pinned commit.  The git-checkout origin must still produce the exact same
# store item because it imports the commit object, not working-tree contents.
dirty_swing="$case_dir/dirty-g-swing"
git clone --quiet --no-hardlinks "$swing_source" "$dirty_swing"
printf '%s\n' dirty >>"$dirty_swing/README.md"
printf '%s\n' untracked >"$dirty_swing/untracked-by-test"
printf '%s\n' ignored >"$dirty_swing/result"
dirty_result=$(GUILE_G_SWING_SOURCE="$dirty_swing" \
  guix build -L "$module_dir" --no-grafts --no-offload \
    -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)')
test "$dirty_result" = "$swing"

case "$swing" in
  /gnu/store/*-guile-g-swing-0.1.0-1.f447747) ;;
  *) echo "unexpected g-swing package: $swing" >&2; exit 1 ;;
esac

env -i PATH="$PATH" HOME="$HOME" XDG_CACHE_HOME="$worker_cache" \
  GUILE_AUTO_COMPILE=0 \
  GUILE_G_SWING_SOURCE="$swing_source" \
  GUILE_WAYLAND_SOURCE="$wayland_source" \
  GUILE_DMENU_CHECKOUT="$project_dir" \
  GUILE_G_SWING_CHECKOUT="$swing_source" \
  GUILE_WAYLAND_CHECKOUT="$wayland_source" \
  GUILE_G_SWING_PACKAGE="$swing" \
  GUILE_WAYLAND_PACKAGE="$wayland" \
  guix shell -L "$module_dir" --no-cwd --container \
    --preserve='^GUILE_(AUTO_COMPILE|D?MENU|G_SWING|WAYLAND)_' \
    --expose="$project_dir" \
    -e '(@ (guile-dmenu-package) guile-g-swing-dmenu)' -- \
    guile --no-auto-compile "$project_dir/tests/swing-dependency-test.scm"
