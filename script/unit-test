#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if test -d "$project_dir/../dependencies/guile-vui"; then
  dependency_root=$(CDPATH= cd -- "$project_dir/../dependencies" && pwd)
else
  dependency_root=$(CDPATH= cd -- "$project_dir/.." && pwd)
fi
test_state=${GUILE_DMENU_TEST_STATE:-${TMPDIR:?TMPDIR must name writable test storage}/guile-dmenu-tests}
GUILE_DMENU_TEST_STATE=$test_state
worker_cache="$test_state/unit-cache"
GUILE_VUI_SOURCE=${GUILE_VUI_SOURCE:-$dependency_root/guile-vui}
GUILE_WAYLAND_SOURCE=${GUILE_WAYLAND_SOURCE:-$dependency_root/guile-wayland}
mkdir -p "$worker_cache"
XDG_CACHE_HOME="$worker_cache"
export XDG_CACHE_HOME GUILE_VUI_SOURCE GUILE_WAYLAND_SOURCE GUILE_DMENU_TEST_STATE

"$project_dir/script/dependency-test"

if test "${GUILE_DMENU_UNIT_SHELL:-0}" != 1 &&
   ! guile --no-auto-compile -c \
     '(use-modules (cairo) (g-golf))' >/dev/null 2>&1; then
  GUILE_DMENU_UNIT_SHELL=1
  export GUILE_DMENU_UNIT_SHELL
  exec guix shell -L "$project_dir/.guix/modules" \
    -e '(@ (guile-dmenu-package) guile-dmenu-devel)' -- \
    "$project_dir/script/unit-test"
fi

if ! guile --no-auto-compile -c '(use-modules (cairo))' \
     >/dev/null 2>&1; then
  cairo_store=$(guix build guile-cairo --no-grafts)
  GUILE_LOAD_PATH="$cairo_store/share/guile/site/3.0${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
  GUILE_LOAD_COMPILED_PATH="$cairo_store/lib/guile/3.0/site-ccache${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
  export GUILE_LOAD_PATH GUILE_LOAD_COMPILED_PATH
fi

guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/question-test.scm"
guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/startup-test.scm"
guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/mcp-test.scm"
guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/structured-prompt-test.scm"
guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/question-command-test.scm"
"$project_dir/tests/question-command-executable-test.sh"
"$project_dir/tests/approval-command-test.sh"
exec guile --no-auto-compile -L "$project_dir/src" \
  "$project_dir/tests/filter-test.scm"
