#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
river_dir=${GUILE_RIVER_DIR:-"$project_dir/../guile-river"}

test -f "$river_dir/manifest.scm"
: "${LOOPX_SHORT_RUNTIME_DIR:?controller-provided short runtime path is required}"
integration_tmp="$LOOPX_SHORT_RUNTIME_DIR/guile-dmenu-integration-$$"
mkdir -m 700 "$integration_tmp"
cleanup_integration_tmp () {
  status=$?
  if test "$status" -ne 0; then
    find "$integration_tmp" -name river.log -type f -exec cat {} \;
  fi
  rm -rf "$integration_tmp"
  exit "$status"
}
trap cleanup_integration_tmp EXIT HUP INT TERM
dmenu=$(guix build -f "$project_dir/.guix/modules/guile-dmenu-package.scm")

GUILE_DMENU_PROJECT_DIR="$project_dir" GUILE_LOAD_COMPILED_PATH= \
guix shell -L "$project_dir/.guix/modules" \
  -m "$project_dir/.guix/integration-manifest.scm" -- env \
  GUILE_DMENU="$dmenu/bin/dmenu" \
  GUILE_DMENU_QUESTIONS="$dmenu/bin/guile-dmenu-questions" \
  GUILE_DMENU_MCP="$dmenu/bin/guile-dmenu-mcp" \
  GUILE_RIVER_DIR="$river_dir" \
  TMPDIR="$integration_tmp" \
  GUILE_WAYLAND_PROTOCOL_PATH="$river_dir/protocol" \
  guile --no-auto-compile \
    -L "$river_dir/src" -L "$river_dir/tests" \
    "$project_dir/tests/integration-test.scm"
