#!/usr/bin/env guile
!#
(use-modules (guile-dmenu approval) (guile-dmenu codex)
             (guile-dmenu question)
             (guile-dmenu structured-prompt) (json)
             (ice-9 getopt-long) (ice-9 exceptions) (ice-9 format))

(define default-timeout 120)
(define (valid-timeout value)
  (and value (let ((n (string->number value))) (and n (> n 0) n))))
(define (now) (/ (get-internal-real-time) internal-time-units-per-second))
(define (diagnose fmt . args) (apply format (current-error-port) fmt args))
(define (runtime-lock display)
  ;; Codex hooks run in a sandbox where XDG_RUNTIME_DIR is readable (for the
  ;; Wayland socket) but may not be writable.  Keep the coordination file in
  ;; the hook's writable temporary directory instead.
  (let ((directory (or (getenv "TMPDIR") "/tmp")))
    (string-append directory "/codex-dmenu-approval-"
                   (number->string (getuid)) "-"
                   (string-map (lambda (c) (if (or (char-alphabetic? c)
                                                   (char-numeric? c)) c #\_))
                               (or display "default"))
                   ".lock")))
(define (acquire-until path deadline)
  (let ((port (open-file path "a")))
    (let loop ()
      (cond ((catch 'system-error
               (lambda () (flock port (logior LOCK_EX LOCK_NB)) #t)
               (lambda args #f))
             port)
            ((>= (now) deadline) (close-port port) #f)
            (else (usleep 50000) (loop))))))
(define (emit value) (scm->json value) (newline))
(define (choice-label choice)
  (cond ((eq? choice 'review) "Review in terminal")
        ((eq? choice 'allow) "Allow once")
        ((eq? choice 'deny) "Deny")
        (else (format #f "~a" choice))))
(define (comment-feedback choice comment)
  (format #f "Selected choice: ~a\nComment: ~a"
          (choice-label choice) comment))
(define (mock-reader response comment)
  (let ((index (cond ((equal? response "Allow once") 0)
                     ((equal? response "Deny") 1)
                     (else #f))))
    (lambda args
      (and index
           (if comment (list 'comment index comment) index)))))

(define (graphical-choice message remaining mock mock-comment)
  (let* ((question
          (make-single-question
           'permission "Codex permission request"
           (list (make-question-option
                  'allow "Allow once"
                  #:description "Run this request once, then ask again next time."
                  #:recommended? #t)
                 (make-question-option
                  'deny "Deny"
                  #:description "Reject this request and return the decision to Codex."))))
         (arguments
          (append (list (list question) #:timeout remaining #:context message)
                  (if mock
                      (list #:reader (mock-reader mock mock-comment))
                      '())))
         (result (apply ask-questions/result arguments)))
    (and (eq? (question-result-status result) 'answered)
         (assq-ref (question-result-answers result) 'permission))))

(let* ((opts (getopt-long (command-line) '((timeout (value #t)))))
       (seconds (or (valid-timeout (option-ref opts 'timeout #f))
                    (valid-timeout (getenv "CODEX_DMENU_TIMEOUT"))
                    default-timeout))
       (deadline (+ (now) seconds)))
  ;; A process-level monotonic backstop also interrupts a Wayland FFI call if
  ;; the compositor stops responding and the cooperative fiber timer cannot run.
  (sigaction SIGALRM (lambda args (primitive-exit 0)))
  (alarm (inexact->exact (ceiling seconds)))
  (with-exception-handler
      (lambda (exception)
        (diagnose "codex-dmenu-approval: ~a~%" exception)
        (primitive-exit 0))
    (lambda ()
      (let* ((request (parse-request (current-input-port)))
             (path (runtime-lock (getenv "WAYLAND_DISPLAY")))
             (lock (and path (acquire-until path deadline))))
        (if (not lock)
            (diagnose "codex-dmenu-approval: lock unavailable or deadline expired~%")
            (dynamic-wind
              (lambda () #t)
              (lambda ()
                (let ((remaining (- deadline (now))))
                  (when (> remaining 0)
                    (let* (;; Tests can inject a stdin-safe mock without moving
                           ;; request contents into its argv or environment.
                           (mock (getenv "CODEX_DMENU_MOCK_RESPONSE"))
                           (mock-comment
                            (let ((value
                                   (getenv "CODEX_DMENU_MOCK_COMMENT")))
                              (and value (not (string-null? value)) value)))
                           (answer
                            (call-with-codex-presentation
                             (lambda ()
                               (graphical-choice (request-message request)
                                                 remaining mock
                                                 mock-comment)))))
                      (cond
                       ((eq? answer 'allow) (emit (allow-result)))
                       ((eq? answer 'deny) (emit (deny-result)))
                       ;; An approval has no decision.message field, so attach
                       ;; its comment through PermissionRequest's supported
                       ;; top-level systemMessage channel instead.
                       ((and (list? answer)
                             (= (length answer) 4)
                             (eq? (car answer) 'choice)
                             (eq? (cadr answer) 'allow)
                             (eq? (caddr answer) 'comment)
                             (string? (cadddr answer)))
                        (emit (allow-result
                               (comment-feedback (cadr answer)
                                                 (cadddr answer)))))
                       ((and (list? answer)
                             (= (length answer) 4)
                             (eq? (car answer) 'choice)
                             (eq? (cadr answer) 'deny)
                             (eq? (caddr answer) 'comment)
                             (string? (cadddr answer)))
                        (emit (deny-result
                               (comment-feedback (cadr answer)
                                                 (cadddr answer))))))))))
              (lambda ()
                (flock lock LOCK_UN)
                (close-port lock))))))))
